# ch01/dxx-app 환경 변수 견본
#
# 이 파일을 .env 로 복사해 실제 값을 채운다.
#   cp .env.sample .env
#
# 0-env.py 가 각 단계 시작 시 이 파일을 읽어 환경 변수로 올린다.
# 셸에 이미 있는 값이 우선한다.

# 필수 — Gemini API 키
GEMINI_API_KEY=
# 선택 — 미지정 시 코드 기본값 사용
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# 선택 — RAG 검색 점수가 이 값보다 낮으면 웹 검색으로 폴백
RAG_MIN_SCORE=0.65
