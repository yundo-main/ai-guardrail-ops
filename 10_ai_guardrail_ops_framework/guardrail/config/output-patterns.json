[
  {
    "field": "email",
    "pattern": "\\b[\\w.+-]+@[\\w-]+\\.[\\w.-]+\\b",
    "flags": []
  },
  {
    "field": "api_key",
    "pattern": "\\b(?:sk|api)[-_][A-Za-z0-9_-]{12,}\\b",
    "flags": ["IGNORECASE"]
  },
  {
    "field": "phone",
    "pattern": "(?<!\\d)(?:\\+?\\d{1,3}[ -]?)?\\d{2,4}[ -]\\d{3,4}[ -]\\d{4}(?!\\d)",
    "flags": []
  },
  {
    "field": "secret_keyword",
    "pattern": "\\b(?:password|secret|private key)\\s*[:=]\\s*\\S+",
    "flags": ["IGNORECASE"]
  }
]
